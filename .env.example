# Resend holds the waitlist. Leave the key blank until you add it.
# Without a key, signups are written to data/waitlist.json on this machine.
RESEND_API_KEY=

# Segment the launch note is sent to. Create one in Resend and paste its id.
# Signups are added to it, including addresses that were already contacts.
RESEND_SEGMENT_ID=

# Public origin used for absolute share-image URLs, e.g. https://example.com.
# Falls back to the Vercel deployment URL, or localhost in development.
SITE_URL=

# Inbox for privacy and waitlist requests. Shown on /privacy and /terms.
# Falls back to hello@cata.app when unset.
CONTACT_EMAIL=

# Optional postal address, printed on the privacy policy when set.
CONTACT_ADDRESS=
